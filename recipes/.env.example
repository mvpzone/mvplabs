# pyful-play environment configuration
# Copy to .env and edit for your setup.

# --- Option A: Vertex AI (recommended for GCP recipes) ---
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global

# --- Option B: AI Studio (hello recipe only) ---
# GOOGLE_API_KEY=your-api-key-here

# --- Maps recipe (optional) ---
# Set to 1 to bypass API Registry and use direct MCP URL
# MAPS_MCP_DIRECT=1

# --- Registry recipe (optional) ---
# MCP_SERVER_NAME=agentregistry-00000000-0000-0000-3069-c4f146e37652
